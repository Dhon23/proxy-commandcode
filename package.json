{
  "name": "proxy-commandcode",
  "version": "2.0.0",
  "description": "Proxy: OpenAI /v1/chat/completions → CommandCode /alpha/generate",
  "main": "src/server.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "build": "bun build --compile --minify --sourcemap ./src/server.ts --outfile proxy",
    "typecheck": "bun run tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.8.5",
    "pino": "^9.6.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "pino-pretty": "^13.0.0",
    "typescript": "^7.0.2"
  }
}
